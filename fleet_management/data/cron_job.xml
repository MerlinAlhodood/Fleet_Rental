<odoo>
    <data>

        <record id="ir_cron_create_invoices_for_weekly_rent" model="ir.cron">
            <field name="name">Create Invoices for Weekly Rent</field>
            <field name="model_id" ref="model_project_contract_line"/>
            <field name="state">code</field>
            <field name="code">model.create_invoice_for_contract_lines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>



