<!--&lt;!&ndash;            <field name="contract_id" invisible="type_selection != 'contract' or move_type != 'in_invoice'"/>&ndash;&gt;-->

<!--            <field name="responsible_selection" invisible="move_type != 'in_invoice' or type_selection == 'contract'"/>-->
<!--            <field name="responsible_customer_id" invisible="responsible_selection != 'customer' or move_type != 'in_invoice' or type_selection == 'contract'"/>-->
<!--            <field name="responsible_driver_id" invisible="responsible_selection != 'driver' or move_type != 'in_invoice' or type_selection == 'contract'"/>-->
<!--            <field name="responsible_company_id" invisible="responsible_selection != 'company' or move_type != 'in_invoice'"/>-->
<!--        </xpath>-->

<!--        <xpath expr="//field[@name='partner_id']" position="attributes">-->
<!--            <attribute name="domain">[('is_vendor', '=', True)]</attribute>-->
        </xpath>

    </field>
</record>







    <record id="fleet_rental_contract_action" model="ir.actions.act_window">
        <field name="name">Fleet Rental Contracts</field>
        <field name="res_model">fleet.rental.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fleet_rental_management"
              name="Fleet Rental"
              sequence="14"
              web_icon="fleet_management,static/description/fleet_rental.png"/>

    <menuitem id="menu_new_fleet_rental" name="Fleet Rental Management"
              parent="menu_fleet_rental_management"
              action="fleet_rental_contract_action" sequence="1"/>
</odoo>
