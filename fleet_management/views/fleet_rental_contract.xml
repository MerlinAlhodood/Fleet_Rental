    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='ref']" position="after">
             <field name="is_contract_expense"/>
            <field name="contract_id" invisible="is_contract_expense == False"/>


<!--            <field name="type_selection" invisible="move_type != 'in_invoice'"/>-->
            <field name="vehicle_id" invisible="1"/>
<!--            &lt;!&ndash; Updated project_id to contract_id &ndash;&gt;-->
