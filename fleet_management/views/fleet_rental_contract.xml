<odoo>
    <record id="view_fleet_rental_contract_form" model="ir.ui.view">
        <field name="name">fleet.rental.contract.form</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <form string="Fleet Rental Contract">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft, running, expired,completed,cancel"/>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" invisible="state != 'running'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_highlight" invisible="state != 'expired'"/>
                    <button name="reset_to_draft" string="Reset To Draft" type="object" class="oe_highlight" invisible="not(state in ('cancel', 'completed'))"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="state != 'draft'"/>
                    </h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="vehicle_ids" widget="many2many_tags" required="1"/>
                        </group>

                        <group>
                            <field name="rent_types" required="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="rental_cost"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                <notebook>
                    <page string="Expense Entries">
                        <field name="expense_entry_ids">
                            <tree editable="bottom">
                                 <field name="item"/>
                                <field name="description"/>
                                <field name="amount"/>
<!--                                <field name="bill_id"/>-->
<!--                                <field name="amount"/>-->
                            </tree>
                        </field>
                    </page>
                    <page string="Invoice Entries">
                        <field name="contract_line_ids" readonly="state != 'draft'">
                            <tree options="{'no_open': True}">
                                <field name="date"/>
                                <field name="amount"/>
                                <field name="is_invoice_created" column_invisible="1"/>
                                 <button name="button_create_invoice" type="object" string="Create Invoice" invisible ="is_invoice_created == True"/>


                            </tree>
                        </field>
                    </page>
<!--                    other payables-->
                    <page string="Other Payables">
                        <field name="other_payables_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="date_payable"/>
                                <field name="description"/>
                                <field name="responsible"/>
                                <field name="vehicle_id" domain="[('id', 'in', parent.vehicle_ids)]"/>
                                <field name="driver_id" readonly="1"/>
                                <field name="amount"/>
                                <field name="is_invoiced" readonly="1" column_invisible="1"/>
                                <field name="is_fine_created" column_invisible="1"/>
                                <button name="button_create_fine" type="object" string="Create Fine"
                        invisible = "responsible != 'driver' or is_fine_created == True" readonly="is_invoiced == True"/>
                            </tree>
                        </field>
                    </page>


                </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fleet_rental_contract_tree" model="ir.ui.view">
        <field name="name">fleet.rental.contract.tree</field>
        <field name="model">fleet.rental.contract</field>
        <field name="arch" type="xml">
            <tree string="Fleet Rental Contracts">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_move_form_inherit" model="ir.ui.view">
