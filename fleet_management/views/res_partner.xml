<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.approved.vendor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">



            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="button_view_driver_fines"
                        string="Fines"
                        type="object"
                        class="oe_stat_button">
                    <field name="fine_count" widget="statinfo" string="Fines"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_vendor"/>
            </xpath>
        </field>
    </record>

     <record id="driver_fines_action" model="ir.actions.act_window">
        <field name="name">Driver Fines</field>
        <field name="res_model">fleet.driver.fine</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('partner_id', '=', active_id)]</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>

</odoo>
